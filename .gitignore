# --- Secrets & credentials (никогда не коммитим) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*.json
secrets/
.secrets/

# --- Production / seller data (Amazon AUP/DPP: не должно попадать в репозиторий) ---
dumps/
exports/
*.dump
*.sql.gz
data/prod/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# --- Logs & temp ---
logs/
*.log
# Логи доказательств шагов (docs/evidence) — часть репозитория: на них ссылаются отчёты и ADR.
!docs/evidence/*.log
tmp/
.tmp/
coverage/

# --- Build outputs & dependencies (стек не выбран; общие шаблоны) ---
node_modules/
dist/
build/
out/
target/
bin/
obj/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
# vendor/ — только для зависимостей сборки других языков; снимки спецификаций каналов и страниц документации хранятся в репозитории.
# vendor/amazon, vendor/aws и vendor/ebay были вне git с шага 22: тест шага 25 по снимку Amazon упал в CI (файлов нет).
vendor/*
!vendor/kaufland/
!vendor/amazon/
!vendor/aws/
!vendor/ebay/
!vendor/healthchecks/
# Шаг 45 [OQ-238]: снимок документации ZITADEL — решение по email_verified и amr стоит на нём; вне git его бы не было в CI
!vendor/zitadel/

# --- Infrastructure ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak
kubeconfig*

# Шаг 48: сюда владелец кладёт файлы eBay, сохранённые в браузере с входом; в репозиторий идёт только обезличенный снимок vendor/ebay/<дата>/
vendor/ebay/incoming/

# Шаг 71: kill-test — файлы каталога клиента и отчёты по ним; в репозиторий не попадают никогда (scripts/killtest отказывает вне этого каталога)
.killtest/
