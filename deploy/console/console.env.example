# Р-159 (шаг 37): развёртывание консоли продавца. Значения — не секреты; секреты лежат ФАЙЛАМИ в REPRACER_SECRETS_DIR.
# Каталог секретов: console_<роль>_pg_url для каждой роли из apps/console/server/config.ts (CONSOLE_ROLES)
REPRACER_SECRETS_DIR=/srv/repracer/secrets
REPRACER_CONSOLE_LOCALE=de
# Р-127: внешняя отметка. `off` — пока аккаунта внешнего сервиса нет (OQ-188). Появился — очистить это значение и
# положить адрес проверки файлом `console_heartbeat_url` в REPRACER_SECRETS_DIR: адрес несёт идентификатор, это секрет
REPRACER_CONSOLE_HEARTBEAT=off
# Р-160: публичное демо — кнопка «посмотреть демо» и гостевой вход наблюдателем без регистрации
REPRACER_CONSOLE_PUBLIC_DEMO=on
# Ключ гостевого издателя кладётся файлом `console_guest_key` в REPRACER_SECRETS_DIR:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out console_guest_key
# `ephemeral` — временный ключ в памяти: ТОЛЬКО пока экземпляр консоли один
REPRACER_CONSOLE_GUEST_KEY=
REPRACER_CONSOLE_DEMO_RESEED_HOURS=24
# Вход продавца [Р-78]: поставщик identity. Задаётся целиком или не задаётся вовсе
REPRACER_CONSOLE_OIDC_ISSUER=
REPRACER_CONSOLE_OIDC_AUDIENCE=
REPRACER_CONSOLE_OIDC_JWKS_URL=
