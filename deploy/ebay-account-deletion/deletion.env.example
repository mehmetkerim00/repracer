# Шаг 49 [Р-192]: значения развёртывания приёмника eBay Marketplace Account Deletion. Секреты — файлами в REPRACER_SECRETS_DIR:
#   ebay_deletion_verification_token  — 32–80 символов A–Z, a–z, 0–9, _ и - (тот же, что введён в портале eBay)
#   ebay_deletion_pg_url              — строка подключения роли svc_ebay_deletion (только EXECUTE на функцию приёма)
#   ebay_client_secret                — секрет приложения eBay (ключ Notification API берётся токеном приложения)
#   ebay_deletion_heartbeat_url       — адрес отметки [Р-127], если REPRACER_EBAY_DELETION_HEARTBEAT пусто
REPRACER_SECRETS_DIR=/srv/repracer/secrets
REPRACER_EBAY_DELETION_ENDPOINT=https://app.example.com/ebay/account-deletion
REPRACER_EBAY_DELETION_ENVIRONMENT=PRODUCTION
# App ID приложения eBay — тот же, что REPRACER_EBAY_CLIENT_ID консоли
REPRACER_EBAY_DELETION_CLIENT_ID=
REPRACER_EBAY_DELETION_HEARTBEAT=off
