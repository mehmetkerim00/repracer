# Шаг 114: конфигурация части Б — живая привязка уведомлений Amazon (очередь SQS, EventBridge, адресаты SP-API).
# Шаблон с заглушками. Настоящие значения — ТОЛЬКО в файле секретов вне репозитория (amazon-notifications.env в каталоге секретов
# владельца, права 600); в репозиторий, журналы и отчёты они не попадают. Порядок заполнения — docs/amazon-notifications-part-b.md.
# Проверка заполненного файла — только «да/нет» по пунктам, без значений:
#   node --experimental-strip-types services/notification-receiver/src/part-b.ts <файл секретов части Б>

# Регион SP-API приложения: EU, NA или FE (наш рынок сейчас — NA, Р-214)
REPRACER_AMAZON_REGION=NA
# Регион AWS, где заведены очередь и правило EventBridge (createDestination EventBridge получает его же)
REPRACER_AWS_REGION=<aws-region>
# Аккаунт AWS — 12 цифр (тот же, что в адресе очереди и в источнике партнёра)
REPRACER_AWS_ACCOUNT_ID=000000000000
# Приложение SP-API: amzn1.sellerapps.app.…
REPRACER_AMAZON_APPLICATION_ID=amzn1.sellerapps.app.<application-id>

# Одна очередь на оба пути (решение владельца): SP-API кладёт ANY_OFFER_CHANGED и PRICING_HEALTH, правило EventBridge — уведомления листингов
REPRACER_SQS_QUEUE_URL=https://sqs.<aws-region>.amazonaws.com/000000000000/<queue-name>
REPRACER_SQS_QUEUE_ARN=arn:aws:sqs:<aws-region>:000000000000:<queue-name>
# Очередь недоставленных (политика переадресации основной очереди, maxReceiveCount = 5 — как у приёмника)
REPRACER_SQS_DLQ_ARN=arn:aws:sqs:<aws-region>:000000000000:<queue-name>-dlq

# Источник партнёра SP-API (появляется после createDestination EventBridge): aws.partner/sellingpartnerapi.amazon.com/{AWS Account Id}/{Application Id}
REPRACER_EVENTBRIDGE_PARTNER_SOURCE=aws.partner/sellingpartnerapi.amazon.com/000000000000/amzn1.sellerapps.app.<application-id>
# Шина партнёра (после «Associate with event bus») и правило на ней с целью — очередь выше
REPRACER_EVENTBRIDGE_BUS_ARN=arn:aws:events:<aws-region>:000000000000:event-bus/aws.partner/sellingpartnerapi.amazon.com/000000000000/amzn1.sellerapps.app.<application-id>
REPRACER_EVENTBRIDGE_RULE_ARN=arn:aws:events:<aws-region>:000000000000:rule/aws.partner/sellingpartnerapi.amazon.com/000000000000/amzn1.sellerapps.app.<application-id>/<rule-name>

# Адресаты SP-API (ответы createDestination): SQS — для ANY_OFFER_CHANGED и PRICING_HEALTH, EventBridge — для уведомлений листингов
REPRACER_SPAPI_DESTINATION_ID_SQS=<destination-id>
REPRACER_SPAPI_DESTINATION_ID_EVENTBRIDGE=<destination-id>

# Ключи AWS процесса приёмника: права только sqs:ReceiveMessage, sqs:DeleteMessage, sqs:ChangeMessageVisibility на эту очередь
REPRACER_AWS_ACCESS_KEY_ID=<access-key-id>
REPRACER_AWS_SECRET_ACCESS_KEY=<secret-access-key>
