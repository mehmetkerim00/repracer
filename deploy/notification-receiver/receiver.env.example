# Пример конфигурации приёмника уведомлений Amazon (OQ-190). Реальные значения — вне репозитория; секреты — файлами.
REPRACER_RECEIVER_ID=receiver-eu-1
# Регион очереди и приложения: EU, NA или FE (очередь заводится на приложение в регионе)
REPRACER_AMAZON_REGION=EU
REPRACER_AMAZON_APPLICATION_ID=amzn1.sellerapps.app.00000000-0000-0000-0000-000000000000
REPRACER_AMAZON_APPLICATION_CREDENTIALS_REF=secret-ref:amazon-application
# Тишина очереди дольше этого — WARNING; пусто — умолчание приёмника (30 минут, A-08 не замерен)
REPRACER_RECEIVER_SILENCE_MS=
# Отметка во внешнем сервисе [Р-127, OQ-194]: файл receiver_heartbeat_url в каталоге секретов; выключить — REPRACER_*_HEARTBEAT=off
# Каталог с файлами секретов: app_pg_url (svc_app), inbound_pg_url (svc_inbound), sqs_queue_url,
# aws_access_key_id, aws_secret_access_key, aws_session_token (если AssumeRole) и channels/<credentials_ref>
REPRACER_SECRETS_DIR=/etc/repracer/secrets
