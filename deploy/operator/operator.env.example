# Настройки панели оператора платформы [Р-165]. Копия этого файла — operator.env, в репозиторий не попадает.
# Секретов здесь НЕТ: строка подключения, ключ почты и адрес отметки приходят файлами из REPRACER_SECRETS_DIR.

# Каталог файлов секретов на сервере (монтируется только на чтение)
REPRACER_SECRETS_DIR=/etc/repracer/secrets

# Вход операторов у поставщика identity [Р-78]
REPRACER_OPERATOR_OIDC_ISSUER=https://repracer.zitadel.cloud
REPRACER_OPERATOR_OIDC_AUDIENCE=repracer-operator
REPRACER_OPERATOR_OIDC_JWKS_URL=https://repracer.zitadel.cloud/oauth/v2/keys

# Куда ведёт ссылка приглашения владельца пилота: адрес КОНСОЛИ продавца
REPRACER_OPERATOR_INVITATION_URL=https://app.example.com/invitation
# REPRACER_OPERATOR_INVITATION_TTL_HOURS=168

# Почта. Пока переменных нет — письма собираются и не уходят (сухой режим, OQ-224)
# REPRACER_MAIL_API_URL=https://api.example.invalid/v1/messages
# REPRACER_MAIL_FROM=no-reply@example.com

# Р-127: внешний контроль. Появился аккаунт — оставить пустым и положить файл operator_heartbeat_url
REPRACER_OPERATOR_HEARTBEAT=off

# Файлы секретов, которые обязаны лежать в REPRACER_SECRETS_DIR:
#   operator_pg_url            — postgres://svc_operator:<пароль>@<хост>:5432/<база>
#   mail_api_key               — ключ провайдера почты (нужен, только если задан REPRACER_MAIL_API_URL)
#   operator_heartbeat_url     — адрес отметки (нужен, только если REPRACER_OPERATOR_HEARTBEAT не `off`)
