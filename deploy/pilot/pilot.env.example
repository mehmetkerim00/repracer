# Шаг 124 [Р-248]: настройки пилота. Скопировать в deploy/pilot/pilot.env (в репозиторий не попадает) и заполнить. Секретов здесь НЕТ: они — файлами в
# каталоге секретов сервера (deploy/pilot/secrets.sh → push-secrets.sh). Значения ниже — заполнители.

# Каталог секретов на сервере (700, владелец — пользователь выкладки; от его uid работают контейнеры процессов)
REPRACER_SECRETS_DIR=/srv/repracer-pilot/secrets
# Имя консоли снаружи: туннель ведёт его на консоль; адрес возврата OAuth Amazon — https://<имя>/connect/callback
REPRACER_PILOT_HOST=app.example.invalid
# База пилота и её регион [Р-60]: имя — как в строках подключения, которые сделал deploy/pilot/secrets.sh (REPRACER_PILOT_DB)
REPRACER_PILOT_DB=repracer_pilot
REPRACER_PILOT_REGION=US

# Состояние приложения Amazon в Developer Central: on — Draft (согласие с version=beta), off — опубликовано (README, §1)
REPRACER_AMAZON_APP_DRAFT=on
# Ссылка на ключи приложения Amazon внутри процессов: значение — имя, сами ключи — файлами (amazon_lwa_client_secret, amazon.env)
REPRACER_AMAZON_APPLICATION_CREDENTIALS_REF=secret-ref:amazon-application

# Вход продавцов у ZITADEL [Р-180] (README, §1): проект, приложение «User Agent» (PKCE) с адресом возврата https://<REPRACER_PILOT_HOST>/auth/callback.
# Токен доступа — JWT (vendor/zitadel/SOURCE.md); адрес — из userinfo, второй фактор — из ID-токена
REPRACER_CONSOLE_OIDC_ISSUER=https://<instance>.zitadel.cloud
REPRACER_CONSOLE_OIDC_AUDIENCE=<project-id>
REPRACER_CONSOLE_OIDC_JWKS_URL=https://<instance>.zitadel.cloud/oauth/v2/keys
REPRACER_CONSOLE_OIDC_CLIENT_ID=<spa-client-id>
REPRACER_CONSOLE_OIDC_SCOPE=openid email profile urn:zitadel:iam:org:project:id:<project-id>:aud

# Панель оператора [Р-165, Р-183]: тот же поставщик, своё приложение «User Agent» с адресом возврата http://127.0.0.1:4327/auth/callback (панель — туннелем SSH)
REPRACER_OPERATOR_OIDC_ISSUER=https://<instance>.zitadel.cloud
REPRACER_OPERATOR_OIDC_AUDIENCE=<project-id>
REPRACER_OPERATOR_OIDC_JWKS_URL=https://<instance>.zitadel.cloud/oauth/v2/keys
REPRACER_OPERATOR_OIDC_CLIENT_ID=<operator-client-id>
# Куда ведёт ссылка приглашения владельца пилота: консоль пилота
REPRACER_OPERATOR_INVITATION_URL=https://app.example.invalid/invite

# Логины ролей выгрузки ClickHouse (пароли — файлами ch_ingest_password, ch_verifier_password); адрес — сервис compose
REPRACER_CH_URL=http://clickhouse:8123
REPRACER_CH_INGEST_USER=pilot_ingest
REPRACER_CH_VERIFIER_USER=pilot_verifier

# Обязательное значение развёртывания планировщика: Kaufland в профиле us не подключается, адрес нужен только для разбора конфигурации
REPRACER_KAUFLAND_FALLBACK_EMAIL=ops@example.invalid

# Р-127: отметок внешнего сервиса нет (OQ-188) — выключены явно. Появятся: пустое значение и файлы *_heartbeat_url в каталоге секретов
REPRACER_SCHEDULER_HEARTBEAT=off
REPRACER_CONSOLE_HEARTBEAT=off
REPRACER_OPERATOR_HEARTBEAT=off
REPRACER_BULK_HEARTBEAT=off

# Почты нет (OQ-224): письма собираются и не уходят, в базе отметка DRY_RUN; приглашение — ссылкой в панели [Р-245]

# Копии базы [шаг 126]: каталог на сервере (владелец — пользователь выкладки), куда сервис backup пишет зашифрованные копии; срок — 7 суток
REPRACER_BACKUP_DIR=/srv/repracer-pilot/backups
# Куда выносить копии с сервера (README, «Копии базы»): pull — машина оператора (deploy/pilot/pull-backups.sh) — выбор пилота (решение владельца
# 2026-11-14); r2 — Cloudflare R2, не включаем без одобрения Мердана (возможны списания). Без выбора выкладки нет
REPRACER_BACKUP_OFFSITE=pull
# Только при r2: адрес бакета https://<бакет>.<ACCOUNT_ID>.r2.cloudflarestorage.com и префикс ключей; ключи R2 — файлами backup_r2_access_key_id и
# backup_r2_secret_access_key в каталоге секретов
REPRACER_BACKUP_R2_BUCKET_URL=
REPRACER_BACKUP_R2_PREFIX=pilot/
