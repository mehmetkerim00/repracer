# Р-158 (шаг 36): production-профиль на один VPS. Значения — не секреты; секреты лежат ФАЙЛАМИ в REPRACER_SECRETS_DIR.
REPRACER_DOMAIN=example.invalid
REPRACER_ACME_EMAIL=betrieb@example.invalid
# Каталог секретов: app_pg_url, admin_pg_url, backup_pg_url (строки подключения), channels/<credentials_ref>
REPRACER_SECRETS_DIR=/srv/repracer/secrets
# Куда кладутся копии базы; срок хранения — не больше семи суток (docs/data-retention.md, OQ-61)
REPRACER_BACKUP_DIR=/srv/repracer/backups
REPRACER_BACKUP_KEEP_DAYS=7
REPRACER_BACKUP_EVERY_SECONDS=86400
# Провалившаяся копия повторяется через этот срок, а не через сутки [находка 8 ревью шага 36]
REPRACER_BACKUP_RETRY_SECONDS=900
# Шаг 54 (OWASP A09): журналы ≥ 12 месяцев — горячий хвост сутками (не меньше 30 суток), дальше месячные архивы
# в архиве платформы (`platform=logs/<проект>/<ГГГГ-ММ>.log.gz`); выгружает таймер хоста deploy/production/systemd
REPRACER_LOGS_HOT_DIR=/srv/repracer/logs
REPRACER_ARCHIVE_DIR=/srv/repracer/archive
REPRACER_LOGS_HOT_DAYS=30
REPRACER_LOGS_KEEP_MONTHS=13

# Шаг 44 [Р-178, Р-180]: вход продавцов у ZITADEL (ADR-0013). Промышленный профиль без этих значений НЕ поднимается.
# Подключение аккаунта — правкой этих строк, не кода: издатель — адрес инстанса, аудитория — ID проекта, клиент — приложение
# типа «User Agent» (PKCE, без секрета) с адресом возврата https://app.<домен>/auth/callback (шаг 46: консоль — на app.<домен>). Значения ниже — заполнители.
REPRACER_CONSOLE_OIDC_ISSUER=https://<instance>.zitadel.cloud
REPRACER_CONSOLE_OIDC_AUDIENCE=<project-id>
REPRACER_CONSOLE_OIDC_JWKS_URL=https://<instance>.zitadel.cloud/oauth/v2/keys
REPRACER_CONSOLE_OIDC_CLIENT_ID=<spa-client-id>
# Аудитория токена доступа у ZITADEL — по scope проекта
REPRACER_CONSOLE_OIDC_SCOPE=openid email profile urn:zitadel:iam:org:project:id:<project-id>:aud
# Шаг 45 [OQ-238, vendor/zitadel/SOURCE.md]: токен доступа приложения — JWT (сервер проверяет его ключами; «opaque» не
# проверится, и вход откажет всем). Адрес для приёма приглашения консоль берёт из userinfo (scope `email` выше), второй
# фактор — из ID-токена: включать «User Info inside ID Token» не нужно.

# Шаг 45 [Р-183]: панель оператора входит у того же поставщика своим приложением «User Agent» (PKCE) с адресом
# возврата http://127.0.0.1:4327/auth/callback (панель открывают туннелем); её значения — deploy/operator/operator.env.example.

# Шаг 46 [Р-184]: лендинг на корне домена, консоль — на app.<домен>. Кнопки «Live demo» и «контакт» лендинга ведут сюда;
# не задано — на блок «скоро» страницы. Появится после развёртывания (шаг 38, ч. 2):
# Публикация лендинга — только явным on и только когда есть Impressum и сведения о защите данных (§ 5 DDG):
# REPRACER_LANDING_PUBLIC=on
# REPRACER_LANDING_DEMO_URL=https://app.<домен>/
# REPRACER_LANDING_CONTACT_URL=mailto:<адрес>

# Шаг 46 (находка 13 ревью шага 45): панель оператора входит в профиль (сервис `operator`), и без этих значений compose
# падает на интерполяции `:?set` — раньше их знал только deploy/operator/operator.env.example. Заполнители:
REPRACER_OPERATOR_OIDC_ISSUER=https://<instance>.zitadel.cloud
REPRACER_OPERATOR_OIDC_AUDIENCE=<project-id>
REPRACER_OPERATOR_OIDC_JWKS_URL=https://<instance>.zitadel.cloud/oauth/v2/keys
# Приложение панели «User Agent» (PKCE); адрес возврата http://127.0.0.1:4327/auth/callback — (проверить), допускает ли
# ZITADEL http-адрес на петле вне режима разработки
REPRACER_OPERATOR_OIDC_CLIENT_ID=<operator-client-id>
REPRACER_OPERATOR_INVITATION_URL=https://app.example.invalid/invite
# Шаг 49 [Р-192, E-18]: приёмник уведомлений eBay Marketplace Account Deletion. Адрес регистрируется в портале eBay
# (Alerts and Notifications) вместе с проверочным токеном (файл ebay_deletion_verification_token); App ID и окружение —
# те же, что у приложения eBay продукта; секрет приложения — файл ebay_client_secret
REPRACER_EBAY_DELETION_ENDPOINT=https://app.example.invalid/ebay/account-deletion
REPRACER_EBAY_DELETION_ENVIRONMENT=PRODUCTION
REPRACER_EBAY_DELETION_CLIENT_ID=<ebay-app-id>
# Шаг 49 [Р-192]: `registered` — после регистрации адреса приёмника в портале eBay; до этого консоль eBay не подключает
REPRACER_EBAY_ACCOUNT_DELETION=
