# Шаг 121 (QA-A): настройки профиля. Скопировать в deploy/qa/qa.env (в репозиторий не попадает) и заполнить.
# Каталог секретов — ВНЕ репозитория, права 700; в нём tunnel.env (образец — deploy/qa/tunnel.env.example)
REPRACER_QA_SECRETS_DIR=/srv/repracer-qa/secrets
# Отметка во внешнем сервисе (Р-127): аккаунта нет — off. Появится: REPRACER_STAND_HEARTBEAT= и файл с адресом:
# REPRACER_STAND_HEARTBEAT_URL_FILE=/run/secrets/... (каталог секретов тогда монтируется в стенд)
REPRACER_STAND_HEARTBEAT=off
REPRACER_BULK_HEARTBEAT=off
# Шаг 121 (QA-A): адрес QA снаружи — проверка «без входа Access консоль не отдаётся» (deploy/qa/smoke.sh)
QA_PUBLIC_URL=https://qa.tmprice.com
