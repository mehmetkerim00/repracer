# Пример конфигурации планировщика (Р-129). Реальные значения — вне репозитория; секреты — файлами в REPRACER_SECRETS_DIR.
REPRACER_SCHEDULER_OWNER=scheduler-eu-1
REPRACER_SCHEDULER_TICK_MS=30000
REPRACER_CH_URL=http://clickhouse.internal:8123
REPRACER_CH_INGEST_USER=repracer_ingest
REPRACER_CH_VERIFIER_USER=repracer_verifier
REPRACER_KAUFLAND_FALLBACK_EMAIL=ops@example.invalid
# Ранний доступ к buy_box_changed [Р-45]: GRANTED включает сверку уведомлений аккаунтов Kaufland
REPRACER_KAUFLAND_BUY_BOX_CHANGED_ACCESS=NOT_GRANTED
REPRACER_KAUFLAND_PARTNER_CREDENTIALS_REF=
REPRACER_AMAZON_APPLICATION_CREDENTIALS_REF=secret-ref:amazon-application
# Каталог с файлами секретов: scheduler_pg_url, app_pg_url, exporter_pg_url, ch_ingest_password, ch_verifier_password,
# heartbeat_url и channels/<credentials_ref> — по файлу на аккаунт канала
REPRACER_SECRETS_DIR=/etc/repracer/secrets

# Р-156 (шаг 36): доставка алертов владельцу. Без этих значений процесс не стартует — кроме явного выключения.
# Аккаунта почтового провайдера у проекта пока нет (OQ-224), поэтому по умолчанию доставка выключена.
REPRACER_SCHEDULER_MAIL=off
# REPRACER_MAIL_API_URL=https://api.example.invalid/v1/messages
# REPRACER_MAIL_FROM=repracer@example.invalid
# Кому писать о событиях ПЛАТФОРМЫ (отставание выгрузки, падающая работа): у них нет тенанта
# REPRACER_OPERATOR_EMAIL=betrieb@example.invalid
# Секреты — файлами в каталоге секретов: mail_api_key, alert_delivery_pg_url

# Шаг 43 [Р-175…Р-177]: OAuth продавца и проверка авторизаций. Пусто — канал «ожидает доступа платформы» [Р-150], работы
# channel-authorizations нет. Секреты — файлами в каталоге секретов; кольцо ключей — JSON {"current":"k1","keys":{"k1":"<base64 32 байта>"}}
# REPRACER_AMAZON_APP_ID=amzn1.sellerapps.app.example
# REPRACER_AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.example
# REPRACER_AMAZON_LWA_CLIENT_SECRET_FILE=/run/secrets/amazon_lwa_client_secret
# REPRACER_CHANNEL_KEYRING_FILE=/run/secrets/channel_keyring.json
# REPRACER_CREDENTIALS_PG_URL_FILE=/run/secrets/credentials_pg_url
# REPRACER_CONNECT_REDIRECT_URL=https://app.example.invalid/connect/callback
