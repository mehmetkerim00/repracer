# Пример конфигурации планировщика (Р-129). Реальные значения — вне репозитория; секреты — файлами в REPRACER_SECRETS_DIR.
REPRACER_SCHEDULER_OWNER=scheduler-eu-1
REPRACER_SCHEDULER_TICK_MS=30000
REPRACER_CH_URL=http://clickhouse.internal:8123
REPRACER_CH_INGEST_USER=repracer_ingest
REPRACER_CH_VERIFIER_USER=repracer_verifier
REPRACER_KAUFLAND_FALLBACK_EMAIL=ops@example.invalid
# Ранний доступ к buy_box_changed [Р-45]: GRANTED включает сверку уведомлений аккаунтов Kaufland
REPRACER_KAUFLAND_BUY_BOX_CHANGED_ACCESS=NOT_GRANTED
REPRACER_KAUFLAND_PARTNER_CREDENTIALS_REF=
REPRACER_AMAZON_APPLICATION_CREDENTIALS_REF=secret-ref:amazon-application
# Каталог с файлами секретов: scheduler_pg_url, app_pg_url, exporter_pg_url, ch_ingest_password, ch_verifier_password,
# heartbeat_url и channels/<credentials_ref> — по файлу на аккаунт канала
REPRACER_SECRETS_DIR=/etc/repracer/secrets
