# Пример конфигурации процесса пути решения за брокером (OQ-190). Реальные значения — вне репозитория; секреты — файлами.
REPRACER_WORKER_ID=worker-eu-1
# Обход-страховка: ждущая запись не остаётся незамеченной, даже если событие потерялось [Р-64]
REPRACER_WORKER_SWEEP_MS=60000
REPRACER_WORKER_PARTITIONS=4
REPRACER_KAFKA_BROKERS=redpanda.internal:9092
REPRACER_KAUFLAND_FALLBACK_EMAIL=ops@example.invalid
REPRACER_KAUFLAND_BUY_BOX_CHANGED_ACCESS=NOT_GRANTED
REPRACER_KAUFLAND_PARTNER_CREDENTIALS_REF=
REPRACER_AMAZON_APPLICATION_CREDENTIALS_REF=secret-ref:amazon-application
# Отметка во внешнем сервисе [Р-127, OQ-194]: файл worker_heartbeat_url в каталоге секретов; выключить — REPRACER_*_HEARTBEAT=off
# Каталог с файлами секретов: app_pg_url (svc_app), dispatcher_pg_url (svc_dispatcher), relay_pg_url (svc_relay)
# и channels/<credentials_ref> — по файлу на аккаунт канала
REPRACER_SECRETS_DIR=/etc/repracer/secrets
