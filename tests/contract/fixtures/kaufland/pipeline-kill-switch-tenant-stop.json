    }
  },
  "steps": [
    {
      "id": "viewer-cannot-stop",
      "kind": "pricingStop",
      "op": "stop",
      "scope": "TENANT",
      "membershipId": "membership-viewer",
      "note": "Synthetic stand check of the kill switch",
      "expect": {
        "status": "FORBIDDEN"
      }
    },
    {
      "id": "operator-stops-tenant",
      "kind": "pricingStop",
      "op": "stop",
      "scope": "TENANT",
      "membershipId": "membership-operator",
      "note": "Synthetic stand check of the kill switch",
      "expect": {
        "status": "STOPPED",
        "stop": {
          "scope": "TENANT",
          "channelAccountId": null
        }
      }
    },
    {
      "id": "operator-stops-tenant-again",
      "kind": "pricingStop",
      "op": "stop",
      "scope": "TENANT",
      "membershipId": "membership-owner",
      "note": "Synthetic stand check of the kill switch",
      "expect": {
        "status": "ALREADY_ACTIVE"
      }
    },
    {
      "id": "fixed-price-held-by-stop",
      "kind": "pipelineRecompute",
      "writeScopeId": "ws-price-de-4601",
      "trigger": {
        "type": "COST_CHANGE"
      },
      "expect": {
        "decision": {
          "outcome": "HELD",
          "rejectionReason": "PRICING_STOPPED"
        }
      }
    },
    {
      "id": "operator-cannot-resume-tenant",
      "kind": "pricingStop",
      "op": "release",
      "stopIndex": 0,
      "membershipId": "membership-operator",
      "note": "Operator tries to resume the tenant",
      "expect": {
        "status": "FORBIDDEN"
      }
    },
    {
      "id": "owner-resumes",
      "kind": "pricingStop",
      "op": "release",
      "stopIndex": 0,
      "membershipId": "membership-owner",
      "note": "Kill switch checked, resuming",
      "expect": {
        "status": "RELEASED"
      }
    },
    {
      "id": "fixed-price-after-resume",
      "kind": "pipelineRecompute",
      "writeScopeId": "ws-price-de-4601",
      "trigger": {
        "type": "COST_CHANGE"
      },
      "expect": {
        "decision": {
          "outcome": "APPROVED",
          "finalMinor": 1500
        }
      }
    }
  ],
