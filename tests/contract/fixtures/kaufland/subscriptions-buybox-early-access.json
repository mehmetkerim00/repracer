  "tags": [
    "subscriptions",
    "r-45"
  ],
  "provenance": {
    "kind": "SYNTHETIC_FROM_DOCS",
    "sources": [
      "docs/decisions.md#Р-45"
    ]
  },
  "world": {
    "clock": "2026-09-14T10:00:00.000Z",
    "tenantId": "10000000-0000-4000-8000-000000000001",
    "channelAccountId": "20000000-0000-4000-8000-000000000001",
    "account": {
      "externalAccountId": "syn-seller-0001",
      "marketplaces": [
        "de",
        "at"
      ]
    },
    "credentials": {
      "seller": {
        "clientKey": "syn-seller-client-key-0001",
