            "event": "buy_box_changed"
          },
          "active": false,
          "channelSubscriptionId": "",
          "error": {
            "code": "PRECONDITION_FAILED",
            "raiseAlert": false
          }
        },
        {
          "spec": {
            "event": "item_unit_changed"
          },
          "active": true,
          "channelSubscriptionId": "201"
        }
      ]
    }
  ],
  "exchanges": [
